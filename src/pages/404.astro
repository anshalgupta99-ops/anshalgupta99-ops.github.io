---
import Base from '../layouts/Base.astro';
import { tenants } from '../data/site';
const t = tenants[0];
---
<Base title="404" description="This page does not exist. Go back to the home page of Anshal Gupta.">
  <main id="main" tabindex="-1" class="nf" data-tenant={t.name}>
    <h1>404<span>Tenant not found</span></h1>
    <dl class="cfg" style="max-width: 460px">
      <dt>domain</dt><dd>"this-path.example"</dd>
      <dt>tenant</dt><dd>null</dd>
      <dt>fallback</dt><dd>"/"</dd>
    </dl>
    <p><a class="btn btn--solid" href="/">Back to the home page</a></p>
  </main>
</Base>
